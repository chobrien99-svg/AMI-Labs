    {
      "id": "2101654188748865693",
      "authorId": "714135850934734849",
      "authorUsername": "_amirbar",
      "authorSlug": "amir-bar",
      "authorName": "Amir Bar",
      "createdAt": "2026-09-20T12:46:20.000Z",
      "text": "Exactly, tokens are now cheap and like Yi reminds us, intelligent agent should be able to compress. \n\nConcretely:\n1. Desk rejection phase based on abstract only\n2. Shorter papers\n3. Cancel author-reviewer discussion phase, it’s now all AI slop anyway. https://t.co/h2P1P1cMiC",
      "url": "https://x.com/_amirbar/status/2101654188748865693",
      "isQuote": true,
      "metrics": {
